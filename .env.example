# =============================================================================
# Variáveis de ambiente da API — copie este arquivo para ".env" e preencha.
# O ".env" NUNCA deve ser versionado (já está no .gitignore).
# Passo a passo completo no README.md, seção "Como rodar localmente".
# =============================================================================

# --- Servidor ---------------------------------------------------------------
PORT=3000

# --- Banco de dados PostgreSQL (obrigatório) ---------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fabrica_software

# --- Autenticação (obrigatório) ----------------------------------------------
# Segredo que assina os tokens JWT. Gere um valor aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# --- Firebase Admin (obrigatório para subir; usado no login com Google) -------
# Console do Firebase > Configurações do projeto > Contas de serviço >
# "Gerar nova chave privada". Copie os campos do JSON baixado para cá.
# Para só subir a API sem login com Google, dá para usar as credenciais
# falsas do arquivo .env.test.example.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# A chave inteira numa linha, com \n no lugar das quebras de linha e entre aspas.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# --- IA (Anthropic Claude) — necessário para os recursos de IA ---------------
# Chave em console.anthropic.com > API Keys. Sem ela a API sobe, mas as rotas
# /api/ai/* respondem com erro.
Claude_API=
CLAUDE_MODEL=claude-sonnet-4-5

# --- Google Drive / Docs / Sheets — documentos gerados e lista de presença -----
# 1) Crie um "ID do cliente OAuth" (tipo App para computador) no Google Cloud
#    Console, com as APIs Google Docs, Drive e Sheets ativadas, e cole o JSON
#    baixado (numa linha) em GOOGLE_OAUTH_CLIENT_JSON.
# 2) Rode:  node controllers/Docs/setup_login.js
#    Ele abre o navegador para login e imprime a linha GOOGLE_API_TOKEN_JSON=...
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_API_TOKEN_JSON=

# --- Geração de código com IA (opcionais; ver README) ------------------------
# CODEGEN_MAX_ARQUIVOS=30
# CODEGEN_MAX_CAMADAS=6
# CODEGEN_CONCORRENCIA=4
# CLAUDE_MODEL_CODEGEN=

# --- Publicação no GitHub (opcionais; sem elas /api/github/* fica desligado) --
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_TOKEN_ENC_KEY=
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/github/oauth/callback
